{
  "crons": [
    {
      "path": "/api/cron/settle-all",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/reap-stale-runs",
      "schedule": "* * * * *"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-developer-merchantid-domain-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain"
        },
        {
          "key": "Content-Disposition",
          "value": "inline"
        }
      ]
    }
  ]
}
