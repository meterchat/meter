# Meter CLI provider keys — set any subset. The provider layer
# tries direct API keys first, then Bedrock (Claude), then OpenRouter, then
# auto-routes to another model. You only need ONE working path to run Meter.

# ── Direct provider keys (Tier 1) ─────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=

# ── AWS Bedrock (Tier 2, Claude models) ───────────────────────────
# BEDROCK_API_KEY or AWS_BEARER_TOKEN_BEDROCK enables Bedrock.
BEDROCK_API_KEY=
AWS_REGION=us-east-1

# ── OpenRouter (Tier 3 — single key covers every model) ───────────
OPENROUTER_API_KEY=

# ── Meter behavior ───────────────────────────────────────────────
# Hard ceiling on $ spent per run (USD). Meter stops fanning out / repairing
# once the burn-down hits this. Empty = no cap.
METER_BUDGET_USD=
