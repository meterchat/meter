{
  "name": "@meterxyz/cli",
  "version": "0.3.1",
  "description": "Meter CLI — a terminal-native coding agent that uses multi-model debate and verification to ship tested diffs.",
  "type": "module",
  "bin": {
    "meter": "./dist/meter.js"
  },
  "files": [
    "dist",
    "bin",
    "src",
    "tui",
    "README.md",
    "METER_CLI.md"
  ],
  "scripts": {
    "meter": "bun run bin/meter.tsx",
    "typecheck": "tsc --noEmit",
    "smoke": "bun run scripts/smoke-offline.ts && bun run scripts/smoke-tui.tsx",
    "build": "bun run scripts/build.ts",
    "prepublishOnly": "bun run scripts/build.ts"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "cli",
    "llm",
    "multi-model",
    "debate",
    "orchestrator"
  ],
  "author": "Meter <hello@meter.chat>",
  "license": "MIT",
  "homepage": "https://meter.chat",
  "repository": {
    "type": "git",
    "url": "https://github.com/meterchat/meter.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/meterchat/meter/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.76.0",
    "@aws-sdk/client-bedrock-runtime": "^3.997.0",
    "@google/generative-ai": "^0.24.1",
    "ink": "^5.1.0",
    "ink-spinner": "^5.0.0",
    "openai": "^6.21.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/react": "^18.3.12",
    "bun-types": "^1.3.14",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
