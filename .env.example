# OpenRouter API key — get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Direct API keys — fallback when OpenRouter hits rate limits
# These enable silent same-model retry + cross-model auto-routing
CLAUDE_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AI...
XAI_API_KEY=xai-...

# AWS Bedrock — fallback for Claude models after direct API
# Single Bedrock API key (starts with ABSK...), set region if not us-east-1
BEDROCK_API_KEY=ABSK...
AWS_REGION=us-east-1

# Stripe — get credentials at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Supabase — get credentials at https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ey...
SUPABASE_SERVICE_ROLE_KEY=ey...

# Supabase Management API — required for /api/setup-db
# Get your personal access token at https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_...

# WebAuthn — set to your domain (no https://)
NEXT_PUBLIC_WEBAUTHN_RP_ID=meter.chat
NEXT_PUBLIC_APP_URL=https://meter.chat

# Signup gate — set to "true" to allow new account creation (default: closed)
ALLOW_SIGNUPS=false

# OAuth — Google (Gmail connector)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth — GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub Webhook — secret for validating push event payloads to /api/log/webhook
GITHUB_WEBHOOK_SECRET=

# OAuth — Vercel
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=

# OAuth — Stripe Connect
STRIPE_CONNECT_CLIENT_ID=

# PostHog — product analytics SDK (project write key, NOT personal API key)
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Meter Log — founder user ID and main session ID for the public log/decisions feed
METER_FOUNDER_USER_ID=
METER_MAIN_SESSION_ID=

# Sentry — error tracking (https://sentry.io)
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_ORG=meter
SENTRY_PROJECT=meter-web
SENTRY_AUTH_TOKEN=sntrys_...

# Token encryption — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_TOKEN_SECRET=
